# Kopiera denna fil till .env.local och fyll i dina värden.

# --- AI-kategorisering (steg 2) ---
# Skapa en nyckel på https://console.anthropic.com/
# Utan nyckel använder appen automatiskt en regelbaserad kategorisering (fungerar offline).
ANTHROPIC_API_KEY=

# Modell som används för kategorisering och uppföljningsförslag
ANTHROPIC_MODEL=claude-sonnet-5

# --- Fordonsuppgifter via regnummer (valfritt) ---
# Utan dessa används demodata. Koppla en svensk fordonstjänst (t.ex.
# Biluppgifter.se, Car.info, Checkbiz eller Fordonsfakta). De flesta kräver
# API-nyckel och ibland tillstånd från Transportstyrelsen. Se README.
# Använd {regnr} som platshållare i URL:en om leverantören vill ha det i sökvägen.
VEHICLE_API_URL=
VEHICLE_API_KEY=

# --- Hämta riktiga mejl via IMAP (Gmail) ---
# Fyll i för att hämta mejl från offert.ditec@gmail.com. Utan dessa körs demoläge.
# IMAP_PASSWORD = ett 16-teckens APP-LÖSENORD från Google (INTE ditt vanliga
# Gmail-lösenord). Skapa det på https://myaccount.google.com/apppasswords
# (kräver att 2-stegsverifiering är påslagen). Se SETUP.md.
# OBS: lägg ALDRIG lösenordet i git – .env.local är gitignore:at.
IMAP_HOST=imap.gmail.com
IMAP_PORT=993
IMAP_SECURE=true
IMAP_USER=offert.ditec@gmail.com
IMAP_PASSWORD=
IMAP_MAILBOX=INBOX
MAIL_FETCH_LIMIT=40

# --- Skicka svar via SMTP (Gmail) ---
# Lämnar du SMTP_USER/SMTP_PASSWORD tomma används IMAP-uppgifterna ovan
# (samma app-lösenord fungerar för både hämtning och skick).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASSWORD=
# Avsändaradress (t.ex. "Ditec Sisjön <offert.ditec@gmail.com>")
SMTP_FROM=offert.ditec@gmail.com
