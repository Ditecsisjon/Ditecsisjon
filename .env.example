# SMS via 46elks (https://46elks.se)
# Lämna tomt för testläge – då loggas SMS i terminalen i stället för att skickas.
ELKS_API_USERNAME=
ELKS_API_PASSWORD=

# Avsändarnamn som syns hos kunden (max 11 tecken, endast A-Z/a-z/0-9)
SMS_FROM=DitecSisjon

# SMS-mall. Platshållare: {namn} {regnr} {bil}
# SMS_TEMPLATE=Hej {namn}! Din bil {regnr} är nu klar för hämtning hos Ditec Sisjön. Välkommen! /Ditec Sisjön

# PORT=3000
