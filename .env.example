# Kopiera denna fil till .env.local och fyll i dina värden.

# --- Inloggning (för hostad version) ---
# Sätt ett eget lösenord så att bara du kommer åt appen på webbadressen.
# Lämnas det tomt (t.ex. lokalt) krävs ingen inloggning.
APP_PASSWORD=

# --- Kategorisering ---
# Inkommande mejl kategoriseras automatiskt med regelbaserad logik (nyckelord).
# Ingen extern AI-tjänst eller API-nyckel behövs – allt körs lokalt.

# --- Fordonsuppgifter via regnummer ---
# GRATIS: I appen finns ett-klicks-länkar till Transportstyrelsen och
# biluppgifter.se, samt fält där du kan fylla i och spara uppgifterna på
# ärendet. Detta kräver ingen konfiguration och kostar inget.
#
# VALFRITT – automatiskt gratis-uppslag (kräver playwright lokalt):
# Kör `npm i -D playwright && npx playwright install chromium` och sätt raden
# nedan. Appen skrapar då Transportstyrelsens gratistjänst när ett mejl öppnas.
# OBS: fungerar lokalt (t.ex. Windows), INTE på Vercel. Kan ibland stoppas av
# reCAPTCHA – då används länkarna/fälten i stället.
# VEHICLE_SCRAPE=transportstyrelsen
#
# VALFRITT – betald leverantör (om du senare vill ha ett riktigt API):
# Koppla t.ex. Biluppgifter.se eller Car.info. Använd {regnr} som platshållare
# i URL:en om leverantören vill ha det i sökvägen.
VEHICLE_API_URL=
VEHICLE_API_KEY=

# --- Hämta riktiga mejl via IMAP ---
# Koppla brevlådan DÄR DINA LEADS KOMMER IN. Dina Eniro-/offertmejl kommer till
# info@ditecsisjon.se (Websupport), så använd de inställningarna. Utan detta
# körs demoläge.
# OBS: lägg ALDRIG lösenordet i git – .env.local är gitignore:at.
#
# --- Alternativ 1: Websupport (info@ditecsisjon.se) – där leads kommer in ---
IMAP_HOST=imap.websupport.se
IMAP_PORT=993
IMAP_SECURE=true
IMAP_USER=info@ditecsisjon.se
IMAP_PASSWORD=
# Leads sorteras redan till mappen "Offerter" i webbmailen, så vi läser bara
# den mappen (allt annat brus filtreras bort automatiskt). Vill du i stället
# läsa hela inkorgen, byt till INBOX.
IMAP_MAILBOX=Offerter
MAIL_FETCH_LIMIT=60

# --- Alternativ 2: Gmail (offert.ditec@gmail.com) ---
# Byt då raderna ovan till detta (kräver ett 16-teckens APP-LÖSENORD från
# https://myaccount.google.com/apppasswords med 2-stegsverifiering på):
# IMAP_HOST=imap.gmail.com
# IMAP_USER=offert.ditec@gmail.com

# --- SMS-utskick (kampanjer) ---
# Utan detta körs demoläge (SMS markeras bara som skickat). För skarpt läge,
# koppla 46elks (svensk SMS-tjänst): skapa konto på https://46elks.se/
SMS_API_USERNAME=
SMS_API_PASSWORD=
SMS_FROM=Ditec

# --- Verkstadsplanerare / tidsbokning (valfritt) ---
# Utan detta används en inbyggd demo-planerare. Se INTEGRATIONER.md för format.
# Tillgänglighet: endpoint som tar emot { requestedISO, competence, service }
# och svarar { requested: {available, technician, dateLabel, slotLabel}, suggestions:[...] }.
PLANNER_API_URL=
PLANNER_API_KEY=
# Verkstadsinfo (tekniker, kompetenser, veckoschema) – GET som svarar
# { technicians:[...], competenceLabels:{...}, week:{days,grid} }.
PLANNER_INFO_URL=

# --- DOBS (månadslista för återbehandling) ---
# GET som svarar { recipients: [...] } i Recipient-format (se INTEGRATIONER.md).
DOBS_API_URL=
DOBS_API_KEY=

# --- Configurator (priser per storlek) ---
# Om Configurator har ett API kan priserna hämtas därifrån. Kontakta oss med
# formatet så kopplar vi det; annars fylls priserna i appens inställningar.
CONFIGURATOR_API_URL=
CONFIGURATOR_API_KEY=

# --- Skicka svar via SMTP ---
# Lämnar du SMTP_USER/SMTP_PASSWORD tomma används IMAP-uppgifterna ovan.
SMTP_HOST=smtp.websupport.se
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASSWORD=
# Avsändaradress (t.ex. "Ditec Sisjön <info@ditecsisjon.se>")
SMTP_FROM=info@ditecsisjon.se
# (För Gmail: SMTP_HOST=smtp.gmail.com och SMTP_FROM=offert.ditec@gmail.com)
