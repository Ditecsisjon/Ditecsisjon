# Kopiera denna fil till .env.local och fyll i dina värden.

# --- AI-kategorisering (steg 2) ---
# Skapa en nyckel på https://console.anthropic.com/
# Utan nyckel använder appen automatiskt en regelbaserad kategorisering (fungerar offline).
ANTHROPIC_API_KEY=

# Modell som används för kategorisering och uppföljningsförslag
ANTHROPIC_MODEL=claude-sonnet-5

# --- Fordonsuppgifter via regnummer (valfritt) ---
# Utan dessa används demodata. Koppla en svensk fordonstjänst (t.ex.
# Biluppgifter.se, Car.info, Checkbiz eller Fordonsfakta). De flesta kräver
# API-nyckel och ibland tillstånd från Transportstyrelsen. Se README.
# Använd {regnr} som platshållare i URL:en om leverantören vill ha det i sökvägen.
VEHICLE_API_URL=
VEHICLE_API_KEY=

# --- Gmail-koppling (steg 3, valfritt) ---
# Skapa ett projekt på https://console.cloud.google.com/ och aktivera Gmail API.
# Se README.md för steg-för-steg-guide.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/gmail/callback
